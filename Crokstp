BtnVoltar.MouseButton1Click:Connect(function()
    if not tpAndando then
        StatusTP.Text = "Aperta GO primeiro"
        StatusTP.TextColor3 = C.ouro
        return
    end
    if not TP_posInicial then
        StatusTP.Text = "Sem posicao inicial"
        return
    end

    StatusTP.Text = "Ativando bypass + voltando..."
    StatusTP.TextColor3 = C.ouro

    task.spawn(function()
        Bypass.Reativar()
        Bypass.Enabled = true
        Bypass.Apply(LP.Character)
        task.wait(0.5)
        StatusTP.Text = "Bypass ativo — subindo"

        local char = LP.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.P = 8000
        bv.Parent = hrp

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 3000
        bg.D = 500
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp

        local tSobe = tick()
        while (tick() - tSobe) < 0.5 do
            if not hrp or not hrp.Parent then break end
            bv.Velocity = Vector3.new(0, 300, 0)
            if hrp.Position.Y >= TP_posInicial.Y + 80 then break end
            task.wait()
        end

        local VELOCIDADE_VOLTA = 700
        local alvoAereo = Vector3.new(TP_posInicial.X, TP_posInicial.Y + 120, TP_posInicial.Z)
        local tVolta = tick()
        local desceuNoLake = false
        local ultimoBypassCheck = tick()

        while (tick() - tVolta) < 30 do
            if tick() - ultimoBypassCheck > 0.5 then
                ultimoBypassCheck = tick()
                if Bypass.IsActive and not Bypass.IsActive() then
                    Bypass.Apply(LP.Character)
                end
            end

            local areaId = LP:GetAttribute("AreaId")
            if areaId == "Lake" and not desceuNoLake then
                desceuNoLake = true
                break
            end

            local c3 = LP.Character
            local h3 = c3 and c3:FindFirstChild("HumanoidRootPart")
            local hum3 = c3 and c3:FindFirstChildOfClass("Humanoid")
            if not h3 or not hum3 or hum3.Health <= 0 then break end
            hrp = h3

            local pos = hrp.Position
            local dy = TP_posInicial.Y - pos.Y
            local distH = (Vector3.new(TP_posInicial.X, 0, TP_posInicial.Z)
                         - Vector3.new(pos.X, 0, pos.Z)).Magnitude

            if distH < 10 and math.abs(dy) < 10 then break end

            local dirAereo = alvoAereo - pos
            if dirAereo.Magnitude < 12 then
                local v = Vector3.new(0, math.clamp(dy * 6, -150, 80), 0)
                if distH > 4 then
                    v = v + Vector3.new(TP_posInicial.X - pos.X, 0, TP_posInicial.Z - pos.Z).Unit
                            * math.min(VELOCIDADE_VOLTA, distH * 5)
                end
                bv.Velocity = v
            else
                bv.Velocity = dirAereo.Unit * VELOCIDADE_VOLTA
            end

            StatusTP.Text = ("Voltando (bypass) • %dm"):format(math.floor(distH))
            task.wait()
        end

        local tDesce = tick()
        while (tick() - tDesce) < 2 do
            if not hrp or not hrp.Parent then break end
            bv.Velocity = Vector3.new(0, -200, 0)
            if hrp.Position.Y <= 72 then break end
            task.wait()
        end

        pcall(function() bv:Destroy() end)
        pcall(function() bg:Destroy() end)
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)

        local SafeZone = workspace:FindFirstChild("World")
        SafeZone = SafeZone and SafeZone:FindFirstChild("Areas")
        SafeZone = SafeZone and SafeZone:FindFirstChild("EggCarryBounds")
        SafeZone = SafeZone and SafeZone:FindFirstChild("SafeZone")

        if SafeZone then
            StatusTP.Text = "Andando ate SafeZone..."
            StatusTP.TextColor3 = C.success

            local tAnda = tick()
            local passos = 0
            while (tick() - tAnda) < 90 do
                local c = LP.Character
                local h = c and c:FindFirstChild("HumanoidRootPart")
                local hum = c and c:FindFirstChildOfClass("Humanoid")
                if not h or not hum then break end

                local d = (h.Position - SafeZone.Position).Magnitude
                if d < 6 then
                    StatusTP.Text = "Entregou ✅"
                    StatusTP.TextColor3 = C.success
                    break
                end

                hum:MoveTo(SafeZone.Position)
                passos = passos + 1
                if passos % 20 == 0 then
                    local alt = SafeZone.Position + Vector3.new(
                        math.random(-6,6), 0, math.random(-6,6))
                    hum:MoveTo(alt)
                end
                StatusTP.Text = ("Andando • %dm"):format(math.floor(d))
                task.wait(0.15)
            end
            pcall(function()
                local c = LP.Character
                local hum = c and c:FindFirstChildOfClass("Humanoid")
                if hum then hum:MoveTo(hum.RootPart.Position) end
            end)
        end

        vooAtivo = false
        tpAndando = false
        BtnGO.BackgroundColor3 = C.success; BtnGO.Text = "GO (só ida)"
        StatusTP.Text = "Pronto ✅"
        StatusTP.TextColor3 = C.success
    end)
end)

