BtnAT.MouseButton1Click:Connect(ToggleAntiTrap)
BtnBat.MouseButton1Click:Connect(ToggleAutoBat)
BtnPrior.MouseButton1Click:Connect(TogglePrior)
BtnKB.MouseButton1Click:Connect(ToggleKB)
BtnESP.MouseButton1Click:Connect(ToggleESP)

local aberto = false

local function abrir()
    if aberto then return end
    aberto = true
    BtnFloat.Visible = false
    Main.Visible = true
    Main.Size = UDim2.new(0,0,0,0)
    Main.Position = UDim2.new(0.5,0,0.5,0)
    TS:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,380,0,520),
        Position = UDim2.new(0.5,-190,0.5,-260)
    }):Play()
    if _G.TPRenderLista then _G.TPRenderLista() end
end

local function fechar()
    if not aberto then return end
    aberto = false
    local tw = TS:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0,0,0,0),
        Position = UDim2.new(0.5,0,0.5,0)
    })
    tw:Play()
    tw.Completed:Connect(function()
        Main.Visible = false
        BtnFloat.Visible = true
    end)
end

BtnMin.MouseButton1Click:Connect(fechar)
BtnClose.MouseButton1Click:Connect(function() SG:Destroy() end)

local arrastando, moveu, offset = false, false, Vector2.new()
BtnFloat.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        arrastando = true; moveu = false
        offset = Vector2.new(i.Position.X - BtnFloat.AbsolutePosition.X, i.Position.Y - BtnFloat.AbsolutePosition.Y)
    end
end)
UIS.InputChanged:Connect(function(i)
    if arrastando and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local np = Vector2.new(i.Position.X - offset.X, i.Position.Y - offset.Y)
        if (np - BtnFloat.AbsolutePosition).Magnitude > 5 then moveu = true end
        BtnFloat.Position = UDim2.new(0, np.X, 0, np.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if arrastando and not moveu then abrir() end
        arrastando = false
    end
end)

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    local k = i.KeyCode
    if k == Enum.KeyCode.K then
        if aberto then fechar() else abrir() end
    elseif k == Enum.KeyCode.B then
        IniciarAutoBug()
    elseif k == Enum.KeyCode.T then
        ToggleAntiTrap()
    elseif k == Enum.KeyCode.G then
        ToggleAutoBat()
    elseif k == Enum.KeyCode.H then
        ToggleKB()
    elseif k == Enum.KeyCode.E then
        ToggleESP()
    end
end)

task.spawn(function()
    task.wait(1)
    if LP.Character then
        Bypass.Enabled = true
        Bypass.Apply(LP.Character)
    end
end)

task.wait(0.5)
abrir()

