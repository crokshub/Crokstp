local function EhBat(t) return t and t:IsA("Tool") and t:GetAttribute("IsBat") == true end

local function AcharBat()
    local char = LP.Character
    if not char then return nil, nil end
    for _, t in ipairs(char:GetChildren()) do if EhBat(t) then return t, "eq" end end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do if EhBat(t) then return t, "moch" end end end
    return nil, nil
end

local function EquiparBat()
    local char = LP.Character
    if not char then return false end
    local bat, onde = AcharBat()
    if not bat or onde == "eq" then return bat ~= nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    pcall(function() hum:EquipTool(bat) end)
    local t0 = tick()
    while bat.Parent ~= char and (tick() - t0) < 0.5 do RunService.Heartbeat:Wait() end
    return bat.Parent == char
end

local function BatEquipada()
    local char = LP.Character
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do if EhBat(t) then return t end end
end

local function TaComOvo(player)
    local c = player.Character
    if not c then return false end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local it = t:GetAttribute("ItemType")
            local uid = t:GetAttribute("UID")
            if it == "Egg" or uid ~= nil then return true end
            if string.find(string.lower(t.Name), "egg") then return true end
        end
    end
    if c:GetAttribute("IsCarrying") == true then return true end
    return player:GetAttribute("IsCarrying") == true
end

local function AcharAlvoBat()
    local comOvo, semOvo = nil, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local hl = c:FindFirstChild("BatTargetHighlight", true)
                if hl and hl:IsA("Highlight") and hl.Enabled ~= false then
                    if TaComOvo(p) then if not comOvo then comOvo = p end
                    else if not semOvo then semOvo = p end end
                end
            end
        end
    end
    if CONFIG.PriorizarOvo then return comOvo or semOvo end
    return semOvo or comOvo
end

