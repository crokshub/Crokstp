local PROPS_TO_COPY = {
    "WalkSpeed","JumpPower","JumpHeight","UseJumpPower","MaxHealth","Health",
    "AutoRotate","AutoJumpEnabled","BreakJointsOnDeath","CameraOffset","DisplayDistanceType",
    "HealthDisplayDistance","HealthDisplayType","NameDisplayDistance","NameOcclusion",
    "RequiresNeck","WalkJumpPower","HipHeight","RigType","WalkSpeedCheck",
    "EvaluateStateMachine","MaxSlopeAngle","AutomaticScalingEnabled",
}

local STATE_ENUMS = {
    Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.GettingUp, Enum.HumanoidStateType.Landed,
    Enum.HumanoidStateType.Flying, Enum.HumanoidStateType.Freefall,
    Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.PlatformStanding,
    Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming,
    Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics,
    Enum.HumanoidStateType.StrafingNoPhysics, Enum.HumanoidStateType.Jumping,
}

local function copyProperties(orig, clone)
    for _, prop in ipairs(PROPS_TO_COPY) do
        pcall(function()
            local ok, v = pcall(function() return orig[prop] end)
            if ok and v ~= nil then pcall(function() clone[prop] = v end) end
        end)
    end
    pcall(function()
        for k, v in pairs(orig:GetAttributes()) do
            pcall(function() clone:SetAttribute(k, v) end)
        end
    end)
end

local function captureStates(hum)
    local s = {}
    for _, st in ipairs(STATE_ENUMS) do
        local ok, e = pcall(function() return hum:GetStateEnabled(st) end)
        if ok then s[st] = e end
    end
    local cur
    pcall(function() cur = hum:GetState() end)
    return s, cur
end

local function reapplyStates(hum, s, cur)
    for st, e in pairs(s or {}) do
        pcall(function() hum:SetStateEnabled(st, e) end)
    end
    if cur then pcall(function() hum:ChangeState(cur) end) end
end

function Bypass.Apply(character)
    if Bypass.InProgress then return false end
    Bypass.InProgress = true

    character = character or LP.Character
    if not character then Bypass.InProgress = false; return false end

    if Bypass.CloneHumanoid and Bypass.CloneHumanoid.Parent
       and Bypass.CloneHumanoid.Health > 0 then
        Bypass.InProgress = false
        return true
    end

    local orig = character:FindFirstChildOfClass("Humanoid")
    if not orig then
        local ok = pcall(function() orig = character:WaitForChild("Humanoid", 5) end)
        if not ok or not orig then Bypass.InProgress = false; return false end
    end

    local clone
    local okC = pcall(function() clone = orig:Clone() end)
    if not okC or not clone then Bypass.InProgress = false; return false end

    local animMove = false
    local anim = orig:FindFirstChildOfClass("Animator")
    if anim then animMove = pcall(function() anim.Parent = clone end) end

    copyProperties(orig, clone)
    local states, cur = captureStates(orig)

    pcall(function() clone.Name = "Humanoid" end)
    local okP = pcall(function() clone.Parent = character end)
    if not okP then
        if animMove and anim and anim.Parent ~= orig then
            pcall(function() anim.Parent = orig end)
        end
        Bypass.InProgress = false
        return false
    end

    task.wait(0.03)
    pcall(function() orig.Parent = nil end)

    task.wait(0.03)
    pcall(function()
        if Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject = clone end
    end)
    reapplyStates(clone, states, cur)

    Bypass.LastChar = character
    Bypass.OriginalHumanoid = orig
    Bypass.CloneHumanoid = clone
    Bypass.OrigParented = false
    Bypass.Enabled = true
    Bypass.InProgress = false
    return true
end

function Bypass.IsActive()
    return Bypass.CloneHumanoid ~= nil
        and Bypass.CloneHumanoid.Parent ~= nil
        and Bypass.CloneHumanoid.Health > 0
end

function Bypass.Desativar()
    pcall(function()
        if Bypass.CloneHumanoid and Bypass.CloneHumanoid.Parent then
            Bypass.CloneHumanoid:Destroy()
        end
        Bypass.CloneHumanoid = nil
        Bypass.Enabled = false

        if Bypass.OriginalHumanoid and Bypass.LastChar then
            pcall(function()
                Bypass.OriginalHumanoid.Parent = Bypass.LastChar
                Bypass.OrigParented = true
            end)
            if Workspace.CurrentCamera then
                Workspace.CurrentCamera.CameraSubject = Bypass.OriginalHumanoid
            end
        end
    end)
end

function Bypass.Reativar()
    if Bypass.OrigParented then
        Bypass.OriginalHumanoid = nil
        Bypass.CloneHumanoid = nil
        Bypass.OrigParented = false
    end
    Bypass.Enabled = true
end

