local espSnap, espSnapAt = nil, 0
local function ESPGetSnapshot()
    if espSnap and os.clock() - espSnapAt < 0.3 then return espSnap end
    local EggState
    pcall(function()
        local n = RS:FindFirstChild("Client")
        n = n and n:FindFirstChild("EggState")
        if n then EggState = require(n) end
    end)
    if EggState and EggState.ReadFieldEggs then
        local ok, d = pcall(EggState.ReadFieldEggs)
        if ok and type(d) == "table" and type(d.Records) == "table" then
            espSnap, espSnapAt = d.Records, os.clock()
            return espSnap
        end
    end
    if Networking then
        local rf = Networking:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot")
        if rf and rf:IsA("RemoteFunction") then
            local ok, r = pcall(rf.InvokeServer, rf)
            if ok and type(r) == "table" and type(r.Records) == "table" then
                espSnap, espSnapAt = r.Records, os.clock()
                return espSnap
            end
        end
    end
end

local function ESPOvosOrdenados()
    local records = ESPGetSnapshot()
    if not records then return {} end
    local lista = {}
    for _, egg in pairs(records) do
        if type(egg) == "table" and egg.Uid
           and typeof(egg.BottomCFrame) == "CFrame"
           and (egg.State == "Slot" or egg.State == "Dropped") then
            local info = InfoOvo(egg.AssetCategory)
            if info.rate > 0 then
                local sc = tonumber(egg.AssetScale) or 1
                local mult = sc > 5 and (sc/5)^1.2 * 19.637875755794113 or sc^1.85
                table.insert(lista, {
                    egg = egg, info = info,
                    valor = info.rate * mult,
                    areaId = egg.AreaId and tostring(egg.AreaId) or "Campo",
                })
            end
        end
    end
