local function TPVoar(destino, bv, bg, hrp)
    local inicio = tick()
    local fase = "subir"
    local alvoAereo = Vector3.new(destino.X, destino.Y + 120, destino.Z)

    while vooAtivo and (tick() - inicio) < 30 do
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local h   = char and char:FindFirstChild("HumanoidRootPart")
        if not h or not hum or hum.Health <= 0 then return false end
        hrp = h

        local pos = hrp.Position

        if fase == "subir" then
            bv.Velocity = Vector3.new(0, 80, 0)
            if pos.Y >= destino.Y + 110 then fase = "voar" end
        elseif fase == "voar" then
            local dir = alvoAereo - pos
            if dir.Magnitude < 10 then fase = "descer"
            else bv.Velocity = dir.Unit * 320 end
        elseif fase == "descer" then
            local dirXZ = Vector3.new(destino.X - pos.X, 0, destino.Z - pos.Z)
            local dy = destino.Y - pos.Y
            if math.abs(dy) < 4 and dirXZ.Magnitude < 6 then return true end
            local v = Vector3.new(0, math.clamp(dy * 3, -60, 20), 0)
            if dirXZ.Magnitude > 4 then
                v = v + dirXZ.Unit * math.min(320, dirXZ.Magnitude * 4)
            end
            bv.Velocity = v
        end
        task.wait()
    end
    return false
end

local function TPIniciarIda(item)
    if tpAndando then return end
    if not item or not item.egg then return end
    tpAndando = true
    vooAtivo = true
    BtnGO.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
    BtnGO.Text = "PARAR"

    task.spawn(function()
        -- DESATIVA BYPASS
        Bypass.Reativar()
        Bypass.Enabled = false
        Bypass.Desativar()
        task.wait(0.3)

        local char = LP.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then
            tpAndando = false; vooAtivo = false
            BtnGO.BackgroundColor3 = C.success; BtnGO.Text = "GO (só ida)"
            return
        end

        if not posicaoSalva then
            posicaoSalva = hrp.Position
            lblBase.Text = ("Base: %.0f, %.0f, %.0f"):format(
                hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
        end
        TP_posInicial = posicaoSalva

        local destino
        pcall(function()
            if item.egg.BottomCFrame then
                destino = item.egg.BottomCFrame.Position
            end
        end)
        if not destino then
            tpAndando = false; vooAtivo = false
            BtnGO.BackgroundColor3 = C.success; BtnGO.Text = "GO (só ida)"
            return
        end

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.P = 1250
        bv.Parent = hrp

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 3000
        bg.D = 500
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp

        StatusTP.Text = "Indo pro ovo: " .. item.info.nome
        StatusTP.TextColor3 = C.accent2

        local chegou = TPVoar(destino, bv, bg, hrp)

        if chegou then
            StatusTP.Text = "PEGA O OVO e clica VOLTAR"
            StatusTP.TextColor3 = C.ouro
            pcall(function() bv:Destroy() end)
            pcall(function() bg:Destroy() end)
        else
            StatusTP.Text = "Falhou em chegar"
            StatusTP.TextColor3 = Color3.fromRGB(255,100,100)
            pcall(function() bv:Destroy() end)
            pcall(function() bg:Destroy() end)
            vooAtivo = false
            tpAndando = false
            BtnGO.BackgroundColor3 = C.success; BtnGO.Text = "GO (só ida)"
        end
    end)
end

